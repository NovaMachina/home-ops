# Copy to secrets.sops.yaml, fill in real values, then encrypt in place:
#   cp secrets.sops.yaml.example secrets.sops.yaml
#   sops --encrypt --in-place secrets.sops.yaml
#
# The .sops.yaml creation rule for terraform/**/*.sops.yaml encrypts the
# whole file. Decryption at plan/apply time uses ./age.key via the
# carlpett/sops provider (see providers.tf).
opnsense:
  # OPNsense: System > Access > Users > (user) > API keys
  api_key: "REPLACE_ME"
  api_secret: "REPLACE_ME"

proxmox:
  # Proxmox: Datacenter > Permissions > API Tokens
  # Format: USER@REALM!TOKENID=UUID
  api_token: "terraform@pve!terraform=REPLACE_ME"
